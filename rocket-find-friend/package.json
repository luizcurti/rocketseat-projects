{
  "name": "findafriend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node20",
    "start": "node dist/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "postman:test": "newman run postman/FindAFriend.postman_collection.json --env-var baseUrl=http://localhost:3333",
    "postman:test:fresh": "newman run postman/FindAFriend.postman_collection.json --env-var baseUrl=http://localhost:3333 --env-var orgEmail=org.$(date +%s)@findafriend.com --env-var orgPassword=123456",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "newman": "^6.2.2",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
