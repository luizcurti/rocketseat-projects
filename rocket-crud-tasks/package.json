{
  "name": "tasks-api",
  "version": "1.0.0",
  "description": "Task management API with CSV bulk import and PostgreSQL",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand --detectOpenHandles --forceExit",
    "test:integration:pg": "RUN_PG_INTEGRATION=true NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration/postgres-task-repository.int.test.ts --runInBand",
    "import-csv": "tsx src/scripts/import-csv.ts",
    "migration:create": "tsx src/scripts/migrations.ts create",
    "migration:up": "tsx src/scripts/migrations.ts up",
    "migration:down": "tsx src/scripts/migrations.ts down"
  },
  "keywords": [
    "nodejs",
    "api",
    "crud",
    "tasks",
    "csv",
    "postgresql",
    "docker"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/server.ts",
      "!src/config/env.ts",
      "!src/scripts/import-csv.ts",
      "!src/scripts/migrations.ts"
    ]
  }
}
